# Secrets — never committed. The gonkagate key lives in .env.local, referenced by name only.
.env
.env.local
*.key
*.pem

# Generated by XcodeGen from project.yml. Deliberately not checked in: the output is
# disposable and regenerating it is 17 ms. If XcodeGen ever dies, run it once more and
# `git add` the result — the escape hatch costs nothing to keep open.
Kotiba.xcodeproj/
spikes/**/*.xcodeproj/

# Xcode / SwiftPM
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/xcode/

# Models and compiled artefacts are fetched via Scripts/Manifest.json, never committed.
# GitHub Releases allows 2 GiB per asset; git-lfs on Free caps a file at 2 GB and meters
# bandwidth, so Releases wins on both counts.
Models/
*.mlmodelc/
*.mlpackage/
*.gguf
*.bin
# …except Home's globe: 529 bytes of Natural Earth land dots (PromoGlobe.swift), not a model.
!Sources/KotibaUI/Resources/GlobeLand.bin
*.safetensors
*.nemo

# macOS
.DS_Store

# Local scratch
/scratch/
*.log
# ...except the preserved evidence, whose README claims to hold it. `*.log` silently holed the
# archive commit once already: eval.log is the 25-clip UzbekVoice result that GAP-01 cites.
!archive/**/*.log
.fleet/
.claude/worktrees/
node_modules/
dist/
__pycache__/

# Per-person build settings (the Apple Team ID). See Config/Kotiba.xcconfig.
Config/Local.xcconfig
.nizom-owner
