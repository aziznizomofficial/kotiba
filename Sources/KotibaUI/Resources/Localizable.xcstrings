    "engine.parakeet.downloading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading (632 MB, once). Until it lands, English uses Apple’s recogniser and Russian waits for it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивается (632 МБ, один раз). До тех пор английский распознаёт движок Apple, а русский ждёт её."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuklanmoqda (632 MB, bir marta). Tugaguncha ingliz tilini Apple dvigateli taniydi, rus tili esa uni kutadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Юкланмоқда (632 МБ, бир марта). Тугагунча инглиз тилини Apple двигатели танийди, рус тили эса уни кутади."
          }
        }
      }
    },
    "engine.parakeet.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load: %@. A backup answers instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить: %@. Вместо неё работает запасная модель."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuklab boʻlmadi: %@. Oʻrniga zaxira model ishlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Юклаб бўлмади: %@. Ўрнига захира модел ишлайди."
          }
        }
      }
    },
    "engine.parakeet.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads with the next dictation. The first load on a Mac compiles it for the Neural Engine, which takes a while once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузится при следующей диктовке. В первый раз Mac компилирует модель для Neural Engine — это займёт некоторое время, но только однажды."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyingi diktovkada yuklanadi. Birinchi marta Mac modelni Neural Engine uchun kompilyatsiya qiladi — bu bir marta biroz vaqt oladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейинги диктовкада юкланади. Биринчи марта Mac моделни Neural Engine учун компиляция қилади — бу бир марта бироз вақт олади."
          }
        }
      }
    },
    "engine.parakeet.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready — fast, with punctuation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово — быстро и с пунктуацией."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayyor — tez va tinish belgilari bilan."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тайёр — тез ва тиниш белгилари билан."
          }
        }
      }
    },
