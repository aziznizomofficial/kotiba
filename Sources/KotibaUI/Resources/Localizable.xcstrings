    "words.replacements.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied once, left to right. A replacement never feeds another one, so a rule cannot loop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяются один раз, слева направо. Одна замена никогда не запускает другую, поэтому правило не может зациклиться."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir marta, chapdan oʻngga qoʻllanadi. Bir almashtirish boshqasini ishga tushirmaydi, shuning uchun qoida aylanib qolmaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир марта, чапдан ўнгга қўлланади. Бир алмаштириш бошқасини ишга туширмайди, шунинг учун қоида айланиб қолмайди."
          }
        }
      }
    },
    "words.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Given to the model before it decodes, which fixes a word before it is misheard rather than after. Kotiba itself comes back as “cotta” without this."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаются модели ещё до распознавания — так слово исправляется до того, как его неверно расслышат, а не после. Без этого даже «Kotiba» превращается в «cotta»."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanishdan oldin modelga beriladi — shunda soʻz notoʻgʻri eshitilgandan keyin emas, undan oldin tuzatiladi. Busiz hatto «Kotiba» ham «cotta» boʻlib chiqadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Танишдан олдин моделга берилади — шунда сўз нотўғри эшитилгандан кейин эмас, ундан олдин тузатилади. Бусиз ҳатто «Kotiba» ҳам «cotta» бўлиб чиқади."
          }
        }
      }
    },
