    "home.quietMic.detail.builtIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is the Mac’s own microphone. Check its input level in Sound settings, or move closer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это встроенный микрофон Mac. Проверьте уровень входа в настройках звука или подвиньтесь ближе."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’ning oʻz mikrofoni. Tovush sozlamalarida kirish darajasini tekshiring yoki yaqinroq keling."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу Mac нинг ўз микрофони. Товуш созламаларида кириш даражасини текширинг ёки яқинроқ келинг."
          }
        }
      }
    },
    "home.quietMic.detail.continuity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That looks like an iPhone (Continuity) microphone, which is easy to pick up by accident. If it isn’t next to you, choose the Mac’s own microphone in Sound settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, это микрофон iPhone (Continuity) — его легко включить случайно. Если iPhone не рядом, выберите встроенный микрофон Mac в настройках звука."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone (Continuity) mikrofoniga oʻxshaydi — uni tasodifan tanlab qoʻyish oson. iPhone yoningizda boʻlmasa, tovush sozlamalarida Mac’ning oʻz mikrofonini tanlang."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу iPhone (Continuity) микрофонига ўхшайди — уни тасодифан танлаб қўйиш осон. iPhone ёнингизда бўлмаса, товуш созламаларида Mac нинг ўз микрофонини танланг."
          }
        }
      }
    },
    "home.quietMic.detail.external": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not the Mac’s own microphone. If you did not mean to use it, choose another input in Sound settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не встроенный микрофон Mac. Если вы не хотели его использовать, выберите другой вход в настройках звука."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’ning oʻz mikrofoni emas. Uni ishlatmoqchi boʻlmasangiz, tovush sozlamalarida boshqa kirishni tanlang."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу Mac нинг ўз микрофони эмас. Уни ишлатмоқчи бўлмасангиз, товуш созламаларида бошқа киришни танланг."
          }
        }
      }
    },
    "home.quietMic.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Sound settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки звука"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tovush sozlamalarini ochish"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Товуш созламаларини очиш"
          }
        }
      }
    },
    "home.quietMic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba hears almost nothing from “%@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba почти ничего не слышит с «%@»"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba «%@» dan deyarli hech narsa eshitmayapti"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba «%@» дан деярли ҳеч нарса эшитмаяпти"
          }
        }
      }
    },
    "home.today.latency": {
