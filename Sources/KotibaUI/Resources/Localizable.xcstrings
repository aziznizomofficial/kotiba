    "polish.status.llama": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba's on-device model — nothing leaves this Mac. English, Russian, Uzbek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственная модель Kotiba на устройстве — ничего не покидает этот Mac. Английский, русский, узбекский."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotibaning qurilmadagi oʻz modeli — hech narsa bu Mac kompyuteridan tashqariga chiqmaydi. Ingliz, rus, oʻzbek tillari."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba дастурининг қурилмадаги ўз модели — ҳеч нарса бу Mac компьютеридан ташқарига чиқмайди. Инглиз, рус, ўзбек тиллари."
          }
        }
      }
    },
    "polish.status.nothing.switchedOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing can polish. Apple's on-device model is switched off above, so add an API key below or turn it back on, or Kotiba will type what you said unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывать нечем. Встроенная модель Apple выключена выше — добавьте API-ключ ниже или включите её снова, иначе Kotiba будет печатать сказанное без изменений."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahrirlaydigan hech narsa yoʻq. Apple’ning qurilmadagi modeli yuqorida oʻchirilgan — quyida API kalitini qoʻshing yoki uni qayta yoqing, aks holda Kotiba aytganingizni oʻzgarishsiz yozadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Таҳрирлайдиган ҳеч нарса йўқ. Apple’нинг қурилмадаги модели юқорида ўчирилган — қуйида API калитини қўшинг ёки уни қайта ёқинг, акс ҳолда Kotiba айтганингизни ўзгаришсиз ёзади."
          }
        }
      }
    },
    "polish.status.nothing.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing can polish. %@ Add an API key below, or Kotiba will type what you said unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывать нечем. %@ Добавьте API-ключ ниже, иначе Kotiba будет печатать сказанное без изменений."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahrirlaydigan hech narsa yoʻq. %@ Quyida API kalitini qoʻshing, aks holda Kotiba aytganingizni oʻzgarishsiz yozadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Таҳрирлайдиган ҳеч нарса йўқ. %@ Қуйида API калитини қўшинг, акс ҳолда Kotiba айтганингизни ўзгаришсиз ёзади."
          }
        }
      }
    },
    "polish.status.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Kotiba types exactly what you said."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено. Kotiba печатает ровно то, что вы сказали."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻchirilgan. Kotiba aynan aytganingizni yozadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ўчирилган. Kotiba айнан айтганингизни ёзади."
          }
        }
      }
    },
    "polish.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model behind Super, Message and Note."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель, на которой работают «Супер», «Сообщение» и «Заметка»."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Super», «Xabar» va «Qayd» ishlaydigan model."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Супер», «Хабар» ва «Қайд» ишлайдиган модель."
          }
        }
      }
    },
    "polish.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give up after"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдаваться через"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutish chegarasi"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Кутиш чегараси"
          }
        }
      }
    },
    "polish.timeout.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On timeout the raw transcript stands. Kotiba also rejects a result that changed length implausibly or came back in another script."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если время вышло, остаётся исходный текст. Kotiba также отбрасывает результат, если его длина неправдоподобно изменилась или он пришёл в другой письменности."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaqt tugasa, asl matn qoladi. Kotiba uzunligi aql bovar qilmas darajada oʻzgargan yoki boshqa yozuvda qaytgan natijani ham rad etadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Вақт тугаса, асл матн қолади. Kotiba узунлиги ақл бовар қилмас даражада ўзгарган ёки бошқа ёзувда қайтган натижани ҳам рад этади."
          }
        }
      }
    },
    "polish.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean-up"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahrirlash"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Таҳрирлаш"
          }
        }
      }
    },
    "polish.uzbekCloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let a cloud model rewrite Uzbek too"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить облачной модели править и узбекский"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulutdagi model oʻzbekchani ham tahrirlasin"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Булутдаги модель ўзбекчани ҳам таҳрирласин"
          }
        }
      }
    },
    "polish.uzbekCloud.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only matters when your own endpoint is on. In testing 7 of 14 cloud rewrites of real Uzbek changed words the speaker did not say — kechqurun became keçşurun. The on-device path never changes an Uzbek word; this one is only guarded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имеет значение, только если включён ваш собственный сервис. В тестах 7 из 14 облачных правок реального узбекского текста изменили слова, которых говорящий не произносил: kechqurun превратилось в keçşurun. На устройстве узбекские слова никогда не меняются; здесь же есть только защита."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat oʻz xizmatingiz yoqilgan boʻlsagina ahamiyatli. Sinovlarda haqiqiy oʻzbekcha matnning 14 ta bulutli tahriridan 7 tasida soʻzlovchi aytmagan soʻzlar oʻzgargan — kechqurun keçşurun boʻlib qolgan. Qurilmadagi yoʻl oʻzbekcha soʻzni hech qachon oʻzgartirmaydi; bu yerda esa faqat himoya bor."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Фақат ўз хизматингиз ёқилган бўлсагина аҳамиятли. Синовларда ҳақиқий ўзбекча матннинг 14 та булутли таҳриридан 7 тасида сўзловчи айтмаган сўзлар ўзгарган — kechqurun keçşurun бўлиб қолган. Қурилмадаги йўл ўзбекча сўзни ҳеч қачон ўзгартирмайди; бу ерда эса фақат ҳимоя бор."
          }
        }
      }
    },
    "rename.legacy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit it from its menu-bar icon (Turn Off Always On & Quit), then reopen Kotiba — your settings, history and models will move over."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте её через значок в строке меню (Turn Off Always On & Quit), затем снова откройте Kotiba — настройки, история и модели перенесутся."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni menyu panelidagi belgisi orqali yoping (Turn Off Always On & Quit), soʻng Kotibani qayta oching — sozlamalar, tarix va modellar koʻchiriladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Уни меню панелидаги белгиси орқали ёпинг (Turn Off Always On & Quit), сўнг Kotiba дастурини қайта очинг — созламалар, тарих ва моделлар кўчирилади."
          }
        }
      }
    },
    "rename.legacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old Kotib is still running"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старая Kotib всё ещё запущена"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski Kotib hali ham ishlab turibdi"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Эски Kotib ҳали ҳам ишлаб турибди"
          }
        }
      }
    },
    "rename.regrant.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings, history, models and key came across, but macOS asks for permissions again under a new name. In System Settings › Privacy & Security, remove the old “Kotib” from Input Monitoring and Accessibility, then switch Kotiba on. Allow the microphone when asked. This note goes away once all three are on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки, история, модели и ключ перенесены, но под новым именем macOS снова спрашивает разрешения. В «Системных настройках» › «Конфиденциальность и безопасность» удалите старую «Kotib» из «Мониторинга ввода» и «Универсального доступа», затем включите Kotiba. Разрешите микрофон, когда появится запрос. Это сообщение исчезнет, когда все три разрешения будут включены."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlamalar, tarix, modellar va kalit koʻchirildi, ammo yangi nom bilan macOS ruxsatlarni qaytadan soʻraydi. «Tizim sozlamalari» › «Maxfiylik va xavfsizlik»da eski «Kotib»ni «Kiritishni kuzatish» va «Maxsus imkoniyatlar»dan olib tashlang, keyin Kotibani yoqing. Soʻralganda mikrofonga ruxsat bering. Uchala ruxsat yoqilgach, bu xabar yoʻqoladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Созламалар, тарих, моделлар ва калит кўчирилди, аммо янги ном билан macOS рухсатларни қайтадан сўрайди. «Тизим созламалари» › «Махфийлик ва хавфсизлик»да эски «Kotib»ни «Киритишни кузатиш» ва «Махсус имкониятлар»дан олиб ташланг, кейин Kotiba дастурини ёқинг. Сўралганда микрофонга рухсат беринг. Учала рухсат ёқилгач, бу хабар йўқолади."
          }
        }
      }
    },
    "rename.regrant.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotib is now Kotiba — allow it once more"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotib теперь Kotiba — разрешите доступ ещё раз"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotib endi Kotiba — ruxsatni yana bir bor bering"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotib энди Kotiba — рухсатни яна бир бор беринг"
          }
        }
      }
    },
