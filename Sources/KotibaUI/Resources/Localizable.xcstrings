{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "about.alsoBuiltOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also built on whisper.cpp, llama.cpp, transcribe.cpp (all MIT) and FluidAudio (Apache-2.0). Full notices: THIRD_PARTY_NOTICES.md in the source repository."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также использует whisper.cpp, llama.cpp, transcribe.cpp (все — MIT) и FluidAudio (Apache-2.0). Полный текст уведомлений — в файле THIRD_PARTY_NOTICES.md в репозитории исходного кода."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuningdek whisper.cpp, llama.cpp, transcribe.cpp (barchasi MIT) va FluidAudio (Apache-2.0) asosida qurilgan. Toʻliq bildirishnomalar: manba kodi omboridagi THIRD_PARTY_NOTICES.md fayli."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Шунингдек whisper.cpp, llama.cpp, transcribe.cpp (барчаси MIT) ва FluidAudio (Apache-2.0) асосида қурилган. Тўлиқ билдиришномалар: манба коди омборидаги THIRD_PARTY_NOTICES.md файли."
          }
        }
      }
    },
    "about.credit.parakeet": {
