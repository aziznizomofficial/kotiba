    "languages.yours.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off languages you don’t speak — Kotiba gets faster and more accurate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите языки, на которых вы не говорите, — Kotiba станет быстрее и точнее."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gapirmaydigan tillaringizni oʻchiring — Kotiba tezroq va aniqroq ishlaydi."
