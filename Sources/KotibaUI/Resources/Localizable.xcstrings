    "stats.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the %1$@ dictations still in the diagnostics log (it keeps the most recent ~2 MB), of which %2$@ heard nothing and %3$@ failed. Time saved is typing time at %4$lld words a minute, minus the time spent speaking and waiting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По %1$@ диктовкам, которые ещё хранятся в журнале диагностики (он хранит последние ~2 МБ); из них в %2$@ ничего не было услышано, а %3$@ завершились ошибкой. Сэкономленное время — это время набора со скоростью %4$lld слов в минуту за вычетом времени на речь и ожидание."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostika jurnalida hali saqlanayotgan %1$@ ta diktovka asosida (jurnal soʻnggi ~2 MB ni saqlaydi); ulardan %2$@ tasida hech narsa eshitilmagan, %3$@ tasi xato bilan tugagan. Tejalgan vaqt — daqiqasiga %4$lld soʻz tezlikda terish vaqtidan gapirish va kutishga ketgan vaqt ayirilgani."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика журналида ҳали сақланаётган %1$@ та диктовка асосида (журнал сўнгги ~2 МБ ни сақлайди); улардан %2$@ тасида ҳеч нарса эшитилмаган, %3$@ таси хато билан тугаган. Тежалган вақт — дақиқасига %4$lld сўз тезликда териш вақтидан гапириш ва кутишга кетган вақт айирилгани."
          }
        }
      }
    },
