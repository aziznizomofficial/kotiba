    "onboarding.done.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re set"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё готово"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammasi tayyor"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳаммаси тайёр"
          }
        }
      }
    },
    "onboarding.hotkey.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ for as long as you are speaking — a word or ten minutes. Let go, and the text lands where your cursor is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@, пока говорите, — хоть одно слово, хоть десять минут. Отпустите — и текст появится там, где стоит курсор."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gapirayotganingizcha %@ tugmasini bosib turing — bitta soʻz boʻlsin yoki oʻn daqiqa. Qoʻyib yuborsangiz, matn kursor turgan joyda paydo boʻladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Гапираётганингизча %@ тугмасини босиб туринг — битта сўз бўлсин ёки ўн дақиқа. Қўйиб юборсангиз, матн курсор турган жойда пайдо бўлади."
          }
        }
      }
    },
    "onboarding.hotkey.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change the key later, in Hotkey."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавишу можно сменить позже в разделе «Горячая клавиша»."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugmani keyinroq «Tezkor tugma» boʻlimida oʻzgartirishingiz mumkin."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тугмани кейинроқ «Тезкор тугма» бўлимида ўзгартиришингиз мумкин."
          }
        }
      }
    },
    "onboarding.hotkey.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте и говорите"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosib turib gapiring"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Босиб туриб гапиринг"
          }
        }
      }
    },
    "onboarding.language.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba will speak to you in it. You can dictate in any language you turn on, whatever you pick here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На нём Kotiba будет с вами общаться. Диктовать можно на любом включённом языке, какой бы вы ни выбрали здесь."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba siz bilan shu tilda muloqot qiladi. Bu yerda qaysi birini tanlasangiz ham, yoqilgan istalgan tilda diktovka qilish mumkin."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba сиз билан шу тилда мулоқот қилади. Бу ерда қайси бирини танласангиз ҳам, ёқилган исталган тилда диктовка қилиш мумкин."
          }
        }
      }
    },
    "onboarding.language.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change it any time in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его можно поменять в любой момент в настройках."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni istalgan vaqtda Sozlamalarda oʻzgartirish mumkin."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Уни исталган вақтда Созламаларда ўзгартириш мумкин."
          }
        }
      }
    },
    "onboarding.language.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your language"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilni tanlang"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тилни танланг"
          }
        }
      }
    },
    "onboarding.languages.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba listens only for these. Their models download in the background while you finish setting up."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba будет слушать только их. Их модели скачаются в фоне, пока вы заканчиваете настройку."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba faqat shu tillarni tinglaydi. Ularning modellari sozlashni tugatguningizcha fonda yuklanadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba фақат шу тилларни тинглайди. Уларнинг моделлари созлашни тугатгунингизча фонда юкланади."
          }
        }
      }
    },
    "onboarding.languages.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which languages do you dictate in?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На каких языках вы диктуете?"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaysi tillarda diktovka qilasiz?"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Қайси тилларда диктовка қиласиз?"
          }
        }
      }
    },
    "onboarding.permissions.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste the text where your cursor is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы вставлять текст туда, где стоит курсор."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Matnni kursor turgan joyga joylashtirish uchun."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Матнни курсор турган жойга жойлаштириш учун."
          }
        }
      }
    },
    "onboarding.permissions.allSet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set — Kotiba can hear, listen for the key, and paste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё готово — Kotiba слышит вас, замечает клавишу и вставляет текст."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammasi tayyor — Kotiba sizni eshitadi, tugmani sezadi va matnni joylashtiradi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳаммаси тайёр — Kotiba сизни эшитади, тугмани сезади ва матнни жойлаштиради."
          }
        }
      }
    },
    "onboarding.permissions.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
