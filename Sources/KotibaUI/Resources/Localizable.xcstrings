    },
    "polish.endpoint.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Every mode works on this Mac; this is for a custom mode that wants a bigger model."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Все режимы работают на этом Mac; это для пользовательского режима, которому нужна модель побольше."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatda oʻchirilgan. Barcha rejimlar shu Mac kompyuterida ishlaydi; bu kattaroq model kerak boʻlgan foydalanuvchi rejimi uchun."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Одатда ўчирилган. Барча режимлар шу Mac компьютерида ишлайди; бу каттароқ модель керак бўлган фойдаланувчи режими учун."
          }
        }
      }
    },
    "polish.endpoint.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес сервиса"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Xizmat manzili"
          }
