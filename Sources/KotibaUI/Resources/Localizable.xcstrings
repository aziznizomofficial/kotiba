        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Рухсат бериш"
          }
        }
      }
    },
    "onboarding.permissions.allow.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks macOS, then opens System Settings at the right switch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает macOS, затем открывает «Системные настройки» на нужном переключателе"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS’dan soʻraydi, soʻng «Tizim sozlamalari»ni kerakli oʻrinda ochadi"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS’дан сўрайди, сўнг «Тизим созламалари»ни керакли ўринда очади"
          }
        }
      }
    },
    "onboarding.permissions.allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruxsat berilgan"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Рухсат берилган"
          }
        }
      }
    },
    "onboarding.permissions.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for each one separately. Kotiba uses them only while you hold the key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запрашивает каждое отдельно. Kotiba пользуется ими, только пока вы удерживаете клавишу."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS har birini alohida soʻraydi. Kotiba ulardan faqat tugmani bosib turganingizda foydalanadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ҳар бирини алоҳида сўрайди. Kotiba улардан фақат тугмани босиб турганингизда фойдаланади."
          }
        }
      }
    },
    "onboarding.permissions.inputMonitoring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To notice the hotkey in any app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы замечать горячую клавишу в любом приложении."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezkor tugmani istalgan ilovada sezish uchun."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тезкор тугмани исталган иловада сезиш учун."
          }
        }
      }
    },
    "onboarding.permissions.microphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы слышать вас."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizni eshitish uchun."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Сизни эшитиш учун."
          }
        }
      }
    },
    "onboarding.permissions.reopen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring can need Kotiba reopened before it takes effect. Kotiba retries on its own every few seconds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы «Мониторинг ввода» заработал, иногда нужно заново открыть Kotiba. Kotiba сама повторяет попытку каждые несколько секунд."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Kiritishni kuzatish» ishlashi uchun baʼzan Kotibani qayta ochish kerak boʻladi. Kotiba har bir necha soniyada oʻzi qayta urinib koʻradi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Киритишни кузатиш» ишлаши учун баъзан Kotiba дастурини қайта очиш керак бўлади. Kotiba ҳар бир неча сонияда ўзи қайта уриниб кўради."
          }
        }
      }
    },
    "onboarding.permissions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three permissions"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три разрешения"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchta ruxsat"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Учта рухсат"
          }
        }
      }
    },
    "onboarding.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip setup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить настройку"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlashni oʻtkazib yuborish"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Созлашни ўтказиб юбориш"
          }
        }
      }
    },
    "onboarding.welcome.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba turns what you say into text in any app — English, Russian and Uzbek, entirely on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba превращает вашу речь в текст в любом приложении — на английском, русском и узбекском, полностью на этом Mac."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba aytganlaringizni istalgan ilovada matnga aylantiradi — ingliz, rus va oʻzbek tillarida, butunlay shu Mac kompyuterining oʻzida."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba айтганларингизни исталган иловада матнга айлантиради — инглиз, рус ва ўзбек тилларида, бутунлай шу Mac компьютерининг ўзида."
          }
        }
      }
    },
    "onboarding.welcome.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshlash"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бошлаш"
          }
        }
      }
    },
    "onboarding.welcome.time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two minutes to set up."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка займёт две минуты."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sozlash ikki daqiqa oladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Созлаш икки дақиқа олади."
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk. Let go. It’s typed."
          }
