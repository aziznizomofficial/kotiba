    "languages.pinned.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned: every dictation is %@ until you choose Automatic. Instant — no detection at all."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплено: каждая диктовка распознаётся как «%@», пока вы не выберете «Автоматически». Мгновенно — без определения языка."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahkamlangan: «Avtomatik»ni tanlamaguningizcha har bir diktovka «%@» deb qabul qilinadi. Bir zumda — tilni aniqlashsiz."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Маҳкамланган: «Автоматик»ни танламагунингизча ҳар бир диктовка «%@» деб қабул қилинади. Бир зумда — тилни аниқлашсиз."
          }
        }
      }
    },
    "languages.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove model files (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить файлы модели (%@)"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
