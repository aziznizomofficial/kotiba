    "onboarding.alwaysOn.card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit closes the window and hides the Dock icon; the menu-bar icon stays and the hotkey keeps working. Switch it off in Settings to let Kotiba exit for real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Выйти» закрывает окно и убирает значок из Dock; значок в строке меню остаётся, и горячая клавиша продолжает работать. Чтобы Kotiba действительно закрывалась, выключите это в настройках."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Chiqish» oynani yopadi va Dock’dagi belgini yashiradi; menyu panelidagi belgi qoladi va tezkor tugma ishlashda davom etadi. Kotiba butunlay yopilishi uchun buni Sozlamalarda oʻchiring."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Чиқиш» ойнани ёпади ва Dock’даги белгини яширади; меню панелидаги белги қолади ва тезкор тугма ишлашда давом этади. Kotiba бутунлай ёпилиши учун буни Созламаларда ўчиринг."
          }
        }
      }
    },
    "onboarding.alwaysOn.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation only works if Kotiba is running. Always on keeps it in the menu bar through quits, crashes, logouts and restarts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка работает, только когда Kotiba запущена. Режим «Всегда включена» держит её в строке меню, даже если её закрыли, она упала, вы вышли из системы или перезагрузили Mac."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovka faqat Kotiba ishlab turganida ishlaydi. «Doim yoniq» rejimi uni yopilganda, nosozlikda, tizimdan chiqilganda va qayta yuklanganda ham menyu panelida saqlab turadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка фақат Kotiba ишлаб турганида ишлайди. «Доим ёниқ» режими уни ёпилганда, носозликда, тизимдан чиқилганда ва қайта юкланганда ҳам меню панелида сақлаб туради."
          }
        }
      }
    },
    "onboarding.alwaysOn.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always there when you reach for it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда под рукой"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Doim yoningizda"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Доим ёнингизда"
          }
        }
      }
    },
    "onboarding.continueAnyway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue anyway"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно продолжить"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Baribir davom etish"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Барибир давом этиш"
          }
        }
      }
    },
    "onboarding.done.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "anywhere and start talking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "в любом приложении и начните говорить."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "va istalgan joyda gapirishni boshlang."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "ва исталган жойда гапиришни бошланг."
          }
        }
      }
    },
    "onboarding.done.start": {
