    "core.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can dictate meanwhile: Uzbek works now, and English uses Apple’s recogniser until this finishes. If it’s interrupted, it carries on where it stopped."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовать можно уже сейчас: узбекский работает, а английский пока распознаёт движок Apple. Если загрузка прервётся, она продолжится с того же места."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozirning oʻzida yozdirishingiz mumkin: oʻzbek tili ishlaydi, ingliz tilini esa hozircha Apple dvigateli taniydi. Yuklash uzilib qolsa, toʻxtagan joyidan davom etadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳозирнинг ўзида ёздиришингиз мумкин: ўзбек тили ишлайди, инглиз тилини эса ҳозирча Apple двигатели танийди. Юклаш узилиб қолса, тўхтаган жойидан давом этади."
          }
        }
      }
    },
