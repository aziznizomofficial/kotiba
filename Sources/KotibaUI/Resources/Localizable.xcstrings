    "languages.whisper.preload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load every language up front"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружать все языки заранее"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha tillarni oldindan yuklash"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Барча тилларни олдиндан юклаш"
          }
        }
      }
    },
    "languages.whisper.preload.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, Kotiba keeps only your main language ready and loads another as you start speaking. On, every language you use stays ready, using more memory."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: Kotiba держит наготове только основной язык и загружает другой, как только вы начинаете говорить. Включено: наготове все ваши языки, но памяти уходит больше."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻchiq: Kotiba faqat asosiy tilingizni tayyor tutadi, boshqasini gapira boshlaganingizda yuklaydi. Yoqilgan: barcha tillaringiz tayyor turadi, lekin xotira koʻproq ketadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ўчиқ: Kotiba фақат асосий тилингизни тайёр тутади, бошқасини гапира бошлаганингизда юклайди. Ёқилган: барча тилларингиз тайёр туради, лекин хотира кўпроқ кетади."
          }
        }
      }
    },
    "languages.whisper.release": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release models after"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгружать модели через"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellarni boʻshatish vaqti"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделларни бўшатиш вақти"
          }
        }
      }
    },
    "languages.whisper.release.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unused this long, the speech models are let go to free memory. They load again as you start speaking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если модели речи не используются столько времени, они выгружаются, чтобы освободить память. Они загрузятся снова, как только вы заговорите."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuncha vaqt ishlatilmasa, nutq modellari xotirani boʻshatish uchun yopiladi. Gapira boshlaganingizda yana yuklanadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Шунча вақт ишлатилмаса, нутқ моделлари хотирани бўшатиш учун ёпилади. Гапира бошлаганингизда яна юкланади."
          }
        }
      }
    },
    "languages.whisper.resident": {
