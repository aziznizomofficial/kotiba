    "home.clipboardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text field had focus, so your last dictation is on the clipboard — press ⌘V where you want it. It’s in History too."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одно поле ввода не было активно, поэтому последняя диктовка скопирована в буфер обмена — нажмите ⌘V там, где она нужна. Она есть и в истории."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hech bir matn maydoni faol emas edi, shuning uchun soʻnggi diktovka buferga nusxalandi — kerakli joyda ⌘V ni bosing. U «Tarix»da ham bor."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳеч бир матн майдони фаол эмас эди, шунинг учун сўнгги диктовка буферга нусхаланди — керакли жойда ⌘V ни босинг. У «Тарих»да ҳам бор."
          }
        }
      }
    },
