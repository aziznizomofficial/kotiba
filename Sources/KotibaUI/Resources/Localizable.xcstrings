    "home.promo.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Kotiba works: hold the key, speak in Uzbek, English, Russian, Arabic or Turkish, let go, and the text arrives in the mode you picked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как работает Kotiba: удерживайте клавишу, говорите по-узбекски, по-английски, по-русски, по-арабски или по-турецки, отпустите — и текст появится в выбранном режиме."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba qanday ishlaydi: tugmani bosib turing, oʻzbekcha, inglizcha, ruscha, arabcha yoki turkcha gapiring, qoʻyib yuboring — matn siz tanlagan rejimda chiqadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba қандай ишлайди: тугмани босиб туринг, ўзбекча, инглизча, русча, арабча ёки туркча гапиринг, қўйиб юборинг — матн сиз танлаган режимда чиқади."
          }
        }
      }
    }
