    "hotkey.advice.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Accessibility as well as Input Monitoring: Kotiba has to swallow the key so holding it types nothing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен «Универсальный доступ» в дополнение к «Мониторингу ввода»: Kotiba должна перехватывать клавишу, чтобы при удержании она ничего не печатала."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Kiritishni kuzatish»dan tashqari «Maxsus imkoniyatlar» ham kerak: bosib turilganda tugma hech narsa yozmasligi uchun Kotiba uni ushlab qolishi kerak."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Киритишни кузатиш»дан ташқари «Махсус имкониятлар» ҳам керак: босиб турилганда тугма ҳеч нарса ёзмаслиги учун Kotiba уни ушлаб қолиши керак."
          }
        }
      }
    },
    "hotkey.advice.globe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS also uses 🌐. Set System Settings › Keyboard › “Press 🌐 key to” to “Do Nothing”, or the emoji picker or Apple Dictation will open too."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS тоже использует 🌐. В «Системных настройках» › «Клавиатура» для параметра «Нажатие клавиши 🌐» выберите «Ничего не делать», иначе заодно будут открываться эмодзи или Диктовка Apple."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ham 🌐 tugmasidan foydalanadi. «Tizim sozlamalari» › «Klaviatura» boʻlimida «🌐 tugmasi bosilganda» parametrini «Hech narsa qilmaslik»ka oʻrnating, aks holda emoji oynasi yoki Apple diktovkasi ham ochiladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ҳам 🌐 тугмасидан фойдаланади. «Тизим созламалари» › «Клавиатура» бўлимида «🌐 тугмаси босилганда» параметрини «Ҳеч нарса қилмаслик»ка ўрнатинг, акс ҳолда эмоджи ойнаси ёки Apple диктовкаси ҳам очилади."
          }
        }
      }
    },
    "hotkey.advice.leftHand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most shortcuts use the left %@. Every shortcut starts a dictation that is cancelled a moment later — the right-hand key avoids that."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство сочетаний клавиш используют левый %@. Каждое такое сочетание запускает диктовку, которая тут же отменяется, — клавиша справа этого избегает."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Koʻpchilik tugmalar birikmasi chap %@ dan foydalanadi. Har bir shunday birikma bir zumda bekor qilinadigan diktovkani boshlab yuboradi — oʻng tomondagi tugma bundan xoli."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Кўпчилик тугмалар бирикмаси чап %@ дан фойдаланади. Ҳар бир шундай бирикма бир зумда бекор қилинадиган диктовкани бошлаб юборади — ўнг томондаги тугма бундан холи."
          }
        }
      }
    },
    "hotkey.advice.mediaKeys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "F1–F12 are media keys on Mac keyboards unless “Use F1, F2, etc. keys as standard function keys” is on; held with fn they always work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На клавиатурах Mac F1–F12 — медиаклавиши, если не включён параметр «Использовать F1, F2 и т. д. как стандартные функциональные клавиши»; вместе с fn они работают всегда."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac klaviaturalarida F1–F12 media tugmalardir, agar «F1, F2 va hokazo tugmalardan standart funksional tugmalar sifatida foydalanish» yoqilmagan boʻlsa; fn bilan birga ular doim ishlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac клавиатураларида F1–F12 медиа тугмалардир, агар «F1, F2 ва ҳоказо тугмалардан стандарт функционал тугмалар сифатида фойдаланиш» ёқилмаган бўлса; fn билан бирга улар доим ишлайди."
          }
        }
      }
    },
    "hotkey.advice.rightOption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On some keyboard layouts right ⌥ types accented letters; those stop working while it is the dictation key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В некоторых раскладках правый ⌥ набирает буквы с диакритикой; пока он назначен клавишей диктовки, они перестанут работать."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Baʼzi klaviatura tartiblarida oʻng ⌥ diakritik harflarni teradi; u diktovka tugmasi boʻlib turganda bu harflar ishlamaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Баъзи клавиатура тартибларида ўнг ⌥ диакритик ҳарфларни теради; у диктовка тугмаси бўлиб турганда бу ҳарфлар ишламайди."
          }
        }
      }
    },
    "hotkey.advice.shift": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ is held while typing capitals. A capital letter typed within 1.5 s of pressing ⇧ cancels the dictation it started."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ удерживают при наборе заглавных букв. Заглавная буква, набранная в течение 1,5 с после нажатия ⇧, отменяет начатую им диктовку."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bosh harflarni terishda ⇧ bosib turiladi. ⇧ bosilgandan keyin 1,5 soniya ichida terilgan bosh harf u boshlagan diktovkani bekor qiladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бош ҳарфларни теришда ⇧ босиб турилади. ⇧ босилгандан кейин 1,5 сония ичида терилган бош ҳарф у бошлаган диктовкани бекор қилади."
          }
        }
      }
    },
    "hotkey.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works in every app, including full-screen ones. The text goes wherever your cursor is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает в любом приложении, в том числе в полноэкранном. Текст появляется там, где стоит курсор."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Har qanday ilovada, jumladan toʻliq ekranli ilovalarda ham ishlaydi. Matn kursor turgan joyga yoziladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳар қандай иловада, жумладан тўлиқ экранли иловаларда ҳам ишлайди. Матн курсор турган жойга ёзилади."
          }
        }
      }
    },
    "hotkey.headsUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads up"
