    "languages.arabic.meanwhile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until it downloads, a backup model answers Arabic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока она скачивается, арабский распознаёт запасная модель."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "U yuklanguncha arabchani zaxira model taniydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "У юклангунча арабчани захира модел танийди."
          }
        }
      }
    },
    "languages.arabic.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern Standard Arabic and the main dialects, with punctuation. Recognised on its own when it clearly sounds Arabic; pin Arabic when it is not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Современный стандартный арабский и основные диалекты, с пунктуацией. Определяется сам, когда речь явно звучит как арабская; иначе закрепите арабский."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamonaviy adabiy arab tili va asosiy shevalar, tinish belgilari bilan. Nutq aniq arabcha eshitilganda oʻzi aniqlanadi; aks holda arab tilini mahkamlang."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Замонавий адабий араб тили ва асосий шевалар, тиниш белгилари билан. Нутқ аниқ арабча эшитилганда ўзи аниқланади; акс ҳолда араб тилини маҳкамланг."
          }
        }
      }
    },
    "languages.automatic.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic: Kotiba works out which one you are speaking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически: Kotiba сама определяет, на каком языке вы говорите."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomatik: qaysi tilda gapirayotganingizni Kotiba oʻzi aniqlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматик: қайси тилда гапираётганингизни Kotiba ўзи аниқлайди."
          }
        }
      }
    },
