    "settings.alwaysOn.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting only closes the window. Kotiba stays in the menu bar, comes back after a crash, logout or restart, and only truly exits when you switch this off."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Выйти» только закрывает окно. Kotiba остаётся в строке меню, возвращается после сбоя, выхода из системы или перезагрузки и по-настоящему закрывается, только если выключить этот параметр."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Chiqish» faqat oynani yopadi. Kotiba menyu panelida qoladi, nosozlik, tizimdan chiqish yoki qayta yuklashdan keyin qaytadi va faqat shu parametr oʻchirilgandagina butunlay yopiladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Чиқиш» фақат ойнани ёпади. Kotiba меню панелида қолади, носозлик, тизимдан чиқиш ёки қайта юклашдан кейин қайтади ва фақат шу параметр ўчирилгандагина бутунлай ёпилади."
          }
        }
      }
    },
    "settings.alwaysThere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always there"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда под рукой"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Doim yoningizda"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Доим ёнингизда"
          }
        }
      }
    },
    "settings.appLanguage.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language of Kotiba’s own words. Dictation works in all three languages whatever you pick."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык, на котором говорит сама Kotiba. Диктовать можно на всех трёх языках, какой бы вы ни выбрали."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotibaning oʻzi gapiradigan til. Qaysi birini tanlasangiz ham, uchala tilda diktovka qilish mumkin."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba дастурининг ўзи гапирадиган тил. Қайси бирини танласангиз ҳам, учала тилда диктовка қилиш мумкин."
          }
        }
      }
    },
    "settings.appLanguage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App language"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык интерфейса"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfeys tili"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Интерфейс тили"
          }
        }
      }
    },
    "settings.builtInMic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the built-in microphone with Bluetooth headphones"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать встроенный микрофон с Bluetooth-наушниками"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth quloqchinlar bilan ichki mikrofondan foydalanish"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth қулоқчинлар билан ички микрофондан фойдаланиш"
          }
        }
      }
    },
    "settings.builtInMic.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording through AirPods switches them to phone-call mode and your music to mono. Kotiba records from the Mac instead, so what you are listening to stays as it was."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись через AirPods переводит их в режим телефонного звонка, а музыку — в моно. Вместо этого Kotiba записывает через Mac, и то, что вы слушаете, звучит как прежде."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods orqali yozish ularni telefon qoʻngʻirogʻi rejimiga, musiqani esa mono rejimga oʻtkazadi. Buning oʻrniga Kotiba Mac orqali yozadi va siz tinglayotgan narsa avvalgidek eshitiladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods орқали ёзиш уларни телефон қўнғироғи режимига, мусиқани эса моно режимга ўтказади. Бунинг ўрнига Kotiba Mac орқали ёзади ва сиз тинглаётган нарса аввалгидек эшитилади."
          }
        }
      }
    },
