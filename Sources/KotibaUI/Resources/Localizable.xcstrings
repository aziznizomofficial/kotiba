    "hotkey.record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record new key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначить новую клавишу"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi tugma tayinlash"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Янги тугма тайинлаш"
          }
        }
      }
    },
    "hotkey.recording.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single modifier — press and release it on its own, like right ⌥ — or a function key such as F13. Escape cancels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна клавиша-модификатор — нажмите и отпустите её отдельно, например правый ⌥, — или функциональная клавиша вроде F13. Esc — отмена."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitta modifikator tugma — uni yolgʻiz bosib, qoʻyib yuboring, masalan oʻng ⌥ — yoki F13 kabi funksional tugma. Esc — bekor qilish."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Битта модификатор тугма — уни ёлғиз босиб, қўйиб юборинг, масалан ўнг ⌥ — ёки F13 каби функционал тугма. Esc — бекор қилиш."
          }
        }
      }
    },
    "hotkey.reject.combination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinations are not supported — hold a single key or a single modifier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания не поддерживаются — удерживайте одну клавишу или один модификатор."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Birikmalar qoʻllanmaydi — bitta tugma yoki bitta modifikatorni bosib turing."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бирикмалар қўлланмайди — битта тугма ёки битта модификаторни босиб туринг."
          }
        }
      }
    },
    "hotkey.reject.typingKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ types text — holding it for Kotiba would stop it working everywhere. Pick a function key or a modifier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ печатает текст — если отдать её Kotiba, она перестанет работать везде. Выберите функциональную клавишу или модификатор."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ matn yozadi — uni Kotibaga bersangiz, u hamma joyda ishlamay qoladi. Funksional tugma yoki modifikatorni tanlang."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ матн ёзади — уни Kotiba дастурига берсангиз, у ҳамма жойда ишламай қолади. Функционал тугма ёки модификаторни танланг."
          }
        }
      }
    },
    "hotkey.shortcuts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts are not dictations"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш — не диктовка"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugmalar birikmasi — diktovka emas"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тугмалар бирикмаси — диктовка эмас"
          }
        }
      }
    },
    "hotkey.shortcuts.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key pressed within 1.5 s of the hotkey means you were typing a shortcut — right ⌘ then C is ⌘C — so that dictation is discarded and nothing is pasted. A key bumped later in a long dictation is let through and the dictation carries on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиша, нажатая в течение 1,5 с после горячей клавиши, означает, что вы набирали сочетание — правый ⌘, а затем C — это ⌘C, — поэтому такая диктовка отбрасывается и ничего не вставляется. Клавиша, случайно задетая позже во время длинной диктовки, пропускается, и диктовка продолжается."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezkor tugmadan keyin 1,5 soniya ichida bosilgan tugma siz tugmalar birikmasini terayotganingizni bildiradi — oʻng ⌘, keyin C — bu ⌘C, — shuning uchun bunday diktovka bekor qilinadi va hech narsa joylashtirilmaydi. Uzun diktovka davomida keyinroq tasodifan bosilgan tugma esa oʻtkazib yuboriladi va diktovka davom etadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тезкор тугмадан кейин 1,5 сония ичида босилган тугма сиз тугмалар бирикмасини тераётганингизни билдиради — ўнг ⌘, кейин C — бу ⌘C, — шунинг учун бундай диктовка бекор қилинади ва ҳеч нарса жойлаштирилмайди. Узун диктовка давомида кейинроқ тасодифан босилган тугма эса ўтказиб юборилади ва диктовка давом этади."
          }
        }
      }
    },
    "hotkey.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold it to talk, let go to paste. As long as you hold, Kotiba listens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте, чтобы говорить, отпустите, чтобы вставить текст. Пока клавиша нажата, Kotiba слушает."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gapirish uchun bosib turing, matnni joylashtirish uchun qoʻyib yuboring. Tugma bosilib turgan ekan, Kotiba tinglaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Гапириш учун босиб туринг, матнни жойлаштириш учун қўйиб юборинг. Тугма босилиб турган экан, Kotiba тинглайди."
          }
        }
      }
    },
