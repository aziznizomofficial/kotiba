    "modes.rightNow.following": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following the app you are in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирается по текущему приложению."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Joriy ilovaga qarab tanlanadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Жорий иловага қараб танланади."
          }
        }
      }
    },
    "modes.rightNow.picked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picked by hand — stays until you choose Automatic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбран вручную — останется, пока вы не выберете «Автоматически»."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoʻlda tanlangan — «Avtomatik»ni tanlamaguningizcha shunday qoladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Қўлда танланган — «Автоматик»ни танламагунингизча шундай қолади."
          }
        }
      }
    },
    "modes.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mode decides what your words turn into. Raw text is pasted the moment you let go; the others clean it up first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим определяет, во что превратятся ваши слова. В режиме «Дословно» текст вставляется сразу, как вы отпустите клавишу; остальные сначала его обрабатывают."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejim soʻzlaringiz nimaga aylanishini belgilaydi. «Soʻzma-soʻz» rejimida matn tugmani qoʻyib yuborishingiz bilan joylashtiriladi; qolganlari avval uni tahrirlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим сўзларингиз нимага айланишини белгилайди. «Сўзма-сўз» режимида матн тугмани қўйиб юборишингиз билан жойлаштирилади; қолганлари аввал уни таҳрирлайди."
          }
        }
      }
    },
    "modes.summary.custom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom mode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательский режим."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Foydalanuvchi rejimi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Фойдаланувчи режими."
          }
        }
      }
    },
    "modes.summary.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chat message you would actually send: filler cut, one point per line, your own register kept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение в чат, которое не стыдно отправить: без слов-паразитов, по одной мысли в строке, в вашем собственном тоне."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatga bemalol yuborsa boʻladigan xabar: ortiqcha soʻzlarsiz, har qatorda bitta fikr, oʻz uslubingizda."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Чатга бемалол юборса бўладиган хабар: ортиқча сўзларсиз, ҳар қаторда битта фикр, ўз услубингизда."
          }
        }
      }
    },
    "modes.summary.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A structured Markdown note: a heading from what you said, bullets, and a checkbox for anything to do."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Структурированная заметка в Markdown: заголовок из сказанного, пункты списка и флажок для каждого дела."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartibli Markdown qaydi: aytganingizdan sarlavha, roʻyxat bandlari va har bir ish uchun belgi katakchasi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тартибли Markdown қайди: айтганингиздан сарлавҳа, рўйхат бандлари ва ҳар бир иш учун белги катакчаси."
          }
        }
      }
    },
    "modes.summary.raw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactly what was said. No model touches it — the fastest path, and what every mode falls back to."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровно то, что было сказано. Никакая модель текст не трогает — самый быстрый путь, к которому в итоге возвращается любой режим."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynan aytilgan narsa. Matnga hech qanday model tegmaydi — eng tez yoʻl va har qanday rejim oxir-oqibat qaytadigan yoʻl."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Айнан айтилган нарса. Матнга ҳеч қандай модель тегмайди — энг тез йўл ва ҳар қандай режим охир-оқибат қайтадиган йўл."
          }
        }
      }
    },
    "modes.summary.super": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words, exactly. Only certain transcription slips are fixed — a stutter goes, nothing else is rewritten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши слова — в точности. Исправляются только явные ошибки распознавания: заикание уходит, больше ничего не переписывается."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynan sizning soʻzlaringiz. Faqat aniq tinish xatolari tuzatiladi — duduqlanish olib tashlanadi, boshqa hech narsa qayta yozilmaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Айнан сизнинг сўзларингиз. Фақат аниқ тиниш хатолари тузатилади — дудуқланиш олиб ташланади, бошқа ҳеч нарса қайта ёзилмайди."
          }
        }
      }
    },
