    "settings.diagnostics.record.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timings and outcomes, kept on this Mac. Statistics are computed from it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время и результаты, хранятся на этом Mac. По ним считается статистика."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaqt va natijalar shu Mac kompyuterida saqlanadi. Statistika shular asosida hisoblanadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
