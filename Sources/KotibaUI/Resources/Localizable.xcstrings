    "settings.ducking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower other audio while I talk"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглушать другие звуки, пока я говорю"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gapirayotganimda boshqa ovozlarni pasaytirish"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Гапираётганимда бошқа овозларни пасайтириш"
          }
        }
      }
    },
    "settings.ducking.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what is already playing is lowered, and only while the key is held. It comes back the moment you let go."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглушается только то, что уже играет, и только пока клавиша удерживается. Громкость вернётся, как только вы её отпустите."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat oʻynab turgan ovoz va faqat tugma bosib turilgan paytda pasaytiriladi. Tugmani qoʻyib yuborishingiz bilan ovoz qaytadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Фақат ўйнаб турган овоз ва фақат тугма босиб турилган пайтда пасайтирилади. Тугмани қўйиб юборишингиз билан овоз қайтади."
          }
        }
      }
    },
