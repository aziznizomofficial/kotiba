    "blocker.noPolisher.meanwhile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until one is available the modes only remove fillers and fix punctuation; Message and Note cannot restructure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока модели нет, режимы только убирают слова-паразиты и исправляют пунктуацию; «Сообщение» и «Заметка» не могут перестраивать текст."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Model paydo boʻlguncha rejimlar faqat ortiqcha soʻzlarni olib tashlaydi va tinish belgilarini tuzatadi; «Xabar» va «Qayd» matnni qayta tuza olmaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель пайдо бўлгунча режимлар фақат ортиқча сўзларни олиб ташлайди ва тиниш белгиларини тузатади; «Хабар» ва «Қайд» матнни қайта туза олмайди."
          }
        }
      }
    },
    "blocker.noPolisher.notDownloaded": {
