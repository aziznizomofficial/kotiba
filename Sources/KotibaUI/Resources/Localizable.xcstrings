    "diagnostics.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics are off. Turn them on to record what happens on each dictation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика выключена. Включите её, чтобы записывать, что происходит при каждой диктовке."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostika oʻchirilgan. Har bir diktovkada nima boʻlayotganini yozib borish uchun uni yoqing."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика ўчирилган. Ҳар бир диктовкада нима бўлаётганини ёзиб бориш учун уни ёқинг."
          }
        }
      }
    },
