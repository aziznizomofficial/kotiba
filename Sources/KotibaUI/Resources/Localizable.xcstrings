    "languages.whisper.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the Uzbek, Turkish and Arabic models run."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как работают модели для узбекского, турецкого и арабского."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Oʻzbek, turk va arab modellari qanday ishlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ўзбек, турк ва араб моделлари қандай ишлайди."
          }
        }
      }
    },
