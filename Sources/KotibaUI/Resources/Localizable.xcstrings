    "settings.quitForReal.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one way to stop an always-on Kotiba. It starts again only when you open it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственный способ остановить Kotiba в режиме «Всегда включена». Снова она запустится, только когда вы её откроете."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Doim yoniq» rejimidagi Kotibani toʻxtatishning yagona yoʻli. U faqat siz uni ochganingizda qayta ishga tushadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Доим ёниқ» режимидаги Kotiba дастурини тўхтатишнинг ягона йўли. У фақат сиз уни очганингизда қайта ишга тушади."
          }
        }
      }
    },
