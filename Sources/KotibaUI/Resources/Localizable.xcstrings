    "modes.rightNow.default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your default."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим по умолчанию."
          }
        },
        "uz-Latn": {
          "stringUnit": {
