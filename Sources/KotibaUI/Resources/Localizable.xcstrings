          "stringUnit": {
            "state": "translated",
            "value": "Slack va Telegram’da — xabar, «Qaydlar» va Obsidian’da — qayd, qolgan hammasida — asosiy rejim."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slack ва Telegram’да — хабар, «Қайдлар» ва Obsidian’да — қайд, қолган ҳаммасида — асосий режим."
          }
        }
      }
    },
    "modes.makeDefault": {
      "extractionState": "manual",
      "localizations": {
