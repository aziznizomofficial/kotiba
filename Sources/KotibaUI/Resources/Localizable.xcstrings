    "appleIntelligence.available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's on-device model is ready."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенная модель Apple готова."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ning qurilmadagi modeli tayyor."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’нинг қурилмадаги модели тайёр."
          }
        }
      }
    },
    "appleIntelligence.deviceNotEligible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac cannot run Apple Intelligence, so on-device clean-up is not available. You can still use your own API key."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не поддерживает Apple Intelligence, поэтому обработка на устройстве недоступна. Можно использовать собственный API-ключ."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac Apple Intelligence’ni qoʻllamaydi, shuning uchun qurilmada tahrirlash mavjud emas. Oʻz API kalitingizdan foydalanishingiz mumkin."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу Mac Apple Intelligence’ни қўлламайди, шунинг учун қурилмада таҳрирлаш мавжуд эмас. Ўз API калитингиздан фойдаланишингиз мумкин."
          }
        }
      }
    },
    "appleIntelligence.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is still downloading its model. Clean-up will start working by itself once that finishes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ещё загружает свою модель. Обработка заработает сама, как только загрузка завершится."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hali oʻz modelini yuklab olmoqda. Yuklash tugashi bilan tahrirlash oʻzi ishlay boshlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ҳали ўз моделини юклаб олмоқда. Юклаш тугаши билан таҳрирлаш ўзи ишлай бошлайди."
          }
        }
      }
    },
    "appleIntelligence.notEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is switched off. Turn it on in System Settings › Apple Intelligence & Siri, and Kotiba can clean up your dictation on this Mac without sending anything anywhere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence выключен. Включите его в «Системных настройках» › Apple Intelligence и Siri — и Kotiba сможет обрабатывать диктовку прямо на этом Mac, никуда ничего не отправляя."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence oʻchirilgan. Uni «Tizim sozlamalari» › Apple Intelligence va Siri boʻlimida yoqing — shunda Kotiba diktovkangizni hech qayerga yubormasdan shu Mac kompyuterida tahrirlay oladi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ўчирилган. Уни «Тизим созламалари» › Apple Intelligence ва Siri бўлимида ёқинг — шунда Kotiba диктовкангизни ҳеч қаерга юбормасдан шу Mac компьютерида таҳрирлай олади."
          }
        }
      }
    },
    "appleIntelligence.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This system does not have Apple's on-device model."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой системе нет встроенной модели Apple."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tizimda Apple’ning qurilmadagi modeli yoʻq."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу тизимда Apple’нинг қурилмадаги модели йўқ."
          }
        }
      }
    },
    "blocker.accessibility.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility for this copy of Kotiba: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите «Универсальный доступ» именно этой копии Kotiba: %@"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotibaning aynan shu nusxasiga «Maxsus imkoniyatlar» ruxsatini bering: %@"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba дастурининг айнан шу нусхасига «Махсус имкониятлар» рухсатини беринг: %@"
          }
        }
      }
    },
    "blocker.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba can’t paste yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba пока не может вставлять текст"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba hozircha matn joylashtira olmaydi"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba ҳозирча матн жойлаштира олмайди"
          }
        }
      }
    },
    "blocker.diagnosticsOpen.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba couldn’t open its diagnostics log, so it can’t explain a failed dictation. (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba не смогла открыть журнал диагностики, поэтому не сможет объяснить неудачную диктовку. (%@)"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba diagnostika jurnalini ocha olmadi, shuning uchun muvaffaqiyatsiz diktovka sababini ayta olmaydi. (%@)"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba диагностика журналини оча олмади, шунинг учун муваффақиятсиз диктовка сабабини айта олмайди. (%@)"
          }
        }
      }
    },
    "blocker.diagnosticsOpen.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics are paused"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика приостановлена"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostika toʻxtab turibdi"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика тўхтаб турибди"
          }
        }
      }
    },
    "blocker.diagnosticsWrite.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
