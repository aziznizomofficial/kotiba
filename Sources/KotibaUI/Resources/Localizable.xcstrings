            "state": "translated",
            "value": "«Автоматически» — Kotiba сама определит, на каком языке вы говорите."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "«Avtomatik» — qaysi tilda gapirayotganingizni Kotiba oʻzi aniqlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "«Автоматик» — қайси тилда гапираётганингизни Kotiba ўзи аниқлайди."
          }
        }
      }
    },
