          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayyor variantlar"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Тайёр вариантлар"
          }
        }
      }
    },
    "hotkey.pressKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the key you want"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите нужную клавишу"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerakli tugmani bosing"
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Керакли тугмани босинг"
          }
        }
