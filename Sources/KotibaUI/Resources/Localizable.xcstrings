    "settings.alwaysOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда включена"
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Doim yoniq"
          }
        },
        "uz-Cyrl": {
