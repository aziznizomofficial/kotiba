    },
    "languages.remove.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ from this Mac? Turn the language back on to download it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ с этого Mac? Чтобы скачать снова, включите язык."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ shu Mac kompyuteridan oʻchirilsinmi? Qayta yuklab olish uchun tilni yana yoqing."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ шу Mac компьютеридан ўчирилсинми? Қайта юклаб олиш учун тилни яна ёқинг."
          }
        }
      }
    },
    "languages.russian.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same model as English, part of the first download. Until it has landed, Russian waits for it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Та же модель, что и для английского, — часть первой загрузки. Пока она не скачана, русский ждёт её."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Inglizcha bilan bir xil model, birinchi yuklanma tarkibida. U yuklanmaguncha rus tili kutadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Инглизча билан бир хил модел, биринчи юкланма таркибида. У юкланмагунча рус тили кутади."
          }
        }
      }
    },
    "languages.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English, Russian and Uzbek, all transcribed on this Mac. Nothing you say leaves it to be turned into text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Английский, русский и узбекский — всё распознаётся на этом Mac. Ничего из сказанного не покидает его ради превращения в текст."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingliz, rus va oʻzbek tillari — hammasi shu Mac kompyuterida matnga aylantiriladi. Aytganlaringiz buning uchun hech qayerga yuborilmaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Инглиз, рус ва ўзбек тиллари — ҳаммаси шу Mac компьютерида матнга айлантирилади. Айтганларингиз бунинг учун ҳеч қаерга юборилмайди."
          }
        }
      }
    },
    "languages.turkish.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded when Turkish is turned on. Recognised by itself in longer dictations; for short ones, choose Turkish above."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивается при включении турецкого. В длинных диктовках распознаётся сам; для коротких выберите турецкий выше."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Turk tili yoqilganda yuklab olinadi. Uzun diktovkalarda oʻzi aniqlanadi; qisqalari uchun yuqorida turk tilini tanlang."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Турк тили ёқилганда юклаб олинади. Узун диктовкаларда ўзи аниқланади; қисқалари учун юқорида турк тилини танланг."
          }
        }
      }
    },
    "languages.uzbek.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba’s Uzbek model, running entirely on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узбекская модель Kotiba, работает полностью на этом Mac."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotibaning oʻzbek modeli, toʻliq shu Mac kompyuterida ishlaydi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba дастурининг ўзбек модели, тўлиқ шу Mac компьютерида ишлайди."
          }
        }
      }
    },
