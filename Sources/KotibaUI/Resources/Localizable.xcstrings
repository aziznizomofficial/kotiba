    "about.credit.parakeet.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA parakeet-tdt-0.6b-v3, post-trained by moondream, Core ML build by FluidInference. Licensed CC BY 4.0; changes were made to the original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA parakeet-tdt-0.6b-v3, дообучение — moondream, сборка Core ML — FluidInference. Лицензия CC BY 4.0; в оригинал внесены изменения."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA parakeet-tdt-0.6b-v3, qoʻshimcha oʻqitish — moondream, Core ML yigʻmasi — FluidInference. CC BY 4.0 litsenziyasi; asl nusxaga oʻzgartirishlar kiritilgan."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA parakeet-tdt-0.6b-v3, қўшимча ўқитиш — moondream, Core ML йиғмаси — FluidInference. CC BY 4.0 лицензияси; асл нусхага ўзгартиришлар киритилган."
          }
        }
      }
    },
