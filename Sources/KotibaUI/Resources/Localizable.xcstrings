    "about.uzbekModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not affiliated with KotibAI (kotib.ai). The Uzbek speech model is Kotib/uzbek_stt_v1 by the Kotibai & Rubai team, used under Apache-2.0; here it is converted to ggml and quantised to q5_0, which is a modification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не связана с KotibAI (kotib.ai). Модель узбекской речи — Kotib/uzbek_stt_v1 от команды Kotibai & Rubai, используется по лицензии Apache-2.0; здесь она сконвертирована в ggml и квантована до q5_0, что является модификацией."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "KotibAI (kotib.ai) bilan bogʻliq emas. Oʻzbek nutqi modeli — Kotibai & Rubai jamoasining Kotib/uzbek_stt_v1 modeli, Apache-2.0 litsenziyasi asosida foydalaniladi; bu yerda u ggml formatiga oʻtkazilgan va q5_0 gacha kvantlangan, bu esa oʻzgartirish hisoblanadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "KotibAI (kotib.ai) билан боғлиқ эмас. Ўзбек нутқи модели — Kotibai & Rubai жамоасининг Kotib/uzbek_stt_v1 модели, Apache-2.0 лицензияси асосида фойдаланилади; бу ерда у ggml форматига ўтказилган ва q5_0 гача квантланган, бу эса ўзгартириш ҳисобланади."
          }
        }
      }
    },
