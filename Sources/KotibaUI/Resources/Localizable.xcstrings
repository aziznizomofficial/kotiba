    "polish.key.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba ships no key and proxies nothing. The request goes from this Mac to the endpoint above. The key is stored in your Keychain, never in settings and never in a diagnostics bundle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba не поставляется с ключом и ничего не проксирует. Запрос идёт с этого Mac напрямую на сервис выше. Ключ хранится в вашей Связке ключей — никогда в настройках и никогда в диагностике."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba hech qanday kalit bilan kelmaydi va hech narsani oʻzi orqali oʻtkazmaydi. Soʻrov shu Mac kompyuteridan toʻgʻridan-toʻgʻri yuqoridagi xizmatga boradi. Kalit Kalitlar toʻplamida saqlanadi — hech qachon sozlamalarda yoki diagnostikada emas."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba ҳеч қандай калит билан келмайди ва ҳеч нарсани ўзи орқали ўтказмайди. Сўров шу Mac компьютеридан тўғридан-тўғри юқоридаги хизматга боради. Калит Калитлар тўпламида сақланади — ҳеч қачон созламаларда ёки диагностикада эмас."
          }
        }
      }
    },
