        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba режимлари модели юклаб олинмаган — унгача режимлар фақат ортиқча сўзлар ва тиниш белгиларини тузатади"
          }
        }
      }
    },
