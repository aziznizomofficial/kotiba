    "home.pickers.mode.automatic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic lets the app you are in choose."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Автоматически» — режим выбирается по приложению, в котором вы работаете."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
