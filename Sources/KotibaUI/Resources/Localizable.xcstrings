      }
    },
    "polish.onDevice.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba’s own model runs Message, Note and Uzbek punctuation in all three languages; Apple’s covers English where Apple Intelligence is on. Nothing leaves the Mac. Without either, the modes still remove fillers and fix punctuation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственная модель Kotiba отвечает за «Сообщение», «Заметку» и узбекскую пунктуацию на всех трёх языках; модель Apple обрабатывает английский, если включён Apple Intelligence. Ничего не покидает Mac. Даже без них режимы убирают слова-паразиты и исправляют пунктуацию."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotibaning oʻz modeli uchala tilda «Xabar», «Qayd» va oʻzbekcha tinish belgilarini bajaradi; Apple modeli esa Apple Intelligence yoqilgan boʻlsa, ingliz tilini ishlaydi. Hech narsa Mac’dan tashqariga chiqmaydi. Ularsiz ham rejimlar ortiqcha soʻzlarni olib tashlaydi va tinish belgilarini tuzatadi."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiba дастурининг ўз модели учала тилда «Хабар», «Қайд» ва ўзбекча тиниш белгиларини бажаради; Apple модели эса Apple Intelligence ёқилган бўлса, инглиз тилини ишлайди. Ҳеч нарса Mac’дан ташқарига чиқмайди. Уларсиз ҳам режимлар ортиқча сўзларни олиб ташлайди ва тиниш белгиларини тузатади."
          }
        }
      }
    },
    "polish.status.apple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's on-device model — nothing leaves this Mac. Languages: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенная модель Apple — ничего не покидает этот Mac. Языки: %@."
          }
        },
        "uz-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ning qurilmadagi modeli — hech narsa bu Mac kompyuteridan tashqariga chiqmaydi. Tillar: %@."
          }
        },
        "uz-Cyrl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’нинг қурилмадаги модели — ҳеч нарса бу Mac компьютеридан ташқарига чиқмайди. Тиллар: %@."
          }
        }
      }
    },
    "polish.status.apple.backstop": {
      "extractionState": "manual",
      "localizations": {
